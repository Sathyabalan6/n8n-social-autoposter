    {
      "id": "form-trigger-1",
      "name": "Social Media Form Trigger",
      "webhookId": "6ff54b3d-9db1-4a28-b8e9-7c6b7fe2ba4e",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [112, 192],
      "parameters": {
        "formTitle": "Social Media Multi-Poster Studio",
        "formDescription": "Publish or schedule posts across LinkedIn, X (Twitter), Facebook, Instagram, Threads, and YouTube.",
        "formFields": {
          "values": [
            { "fieldLabel": "Master Description / Content", "fieldType": "textarea", "requiredField": true },
            { "fieldLabel": "Master Hashtags" },
            { "fieldLabel": "Media Attachment", "fieldType": "file" },
            { "fieldLabel": "Schedule Time (Leave blank for immediate)", "fieldType": "date" },
            {
              "fieldLabel": "Select Platforms to Publish",
              "fieldType": "checkbox",
              "fieldOptions": {
                "values": [
                  { "option": "YouTube" },
                  { "option": "X (Twitter)" },
                  { "option": "LinkedIn" },
                  { "option": "Facebook" },
                  { "option": "Instagram" },
                  { "option": "Threads" }
                ]
              }
            },
            { "fieldLabel": "YouTube Video Title" },
            { "fieldLabel": "X (Twitter) Custom Copy (max 280 chars)", "fieldType": "textarea" },
            { "fieldLabel": "LinkedIn Custom Copy", "fieldType": "textarea" },
            { "fieldLabel": "Instagram Custom Caption", "fieldType": "textarea" },
            { "fieldLabel": "Threads Custom Copy", "fieldType": "textarea" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "normalize-form-data",
      "name": "Normalize Form Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 192],
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst now = new Date();\n\nconst selected = Array.isArray(data['Select Platforms to Publish'])\n  ? data['Select Platforms to Publish']\n  : (data['Select Platforms to Publish'] ? [data['Select Platforms to Publish']] : []);\n\nconst hasPlatform = (name) => selected.some(p => String(p).toLowerCase().includes(name.toLowerCase()));\nconst postYouTube = hasPlatform('youtube') || Boolean(data['YouTube Video Title'] && data['YouTube Video Title'].trim());\n\nconst baseText = data['Master Description / Content'] || '';\nconst rawTags = data['Master Hashtags'] || '';\n\n// Format tags for YouTube: remove '#' and join with comma\nconst ytTags = rawTags\n  .split(/[\\s,]+/)\n  .map(t => t.replace(/^#/, '').trim())\n  .filter(Boolean)\n  .join(', ');\n\n// Format hashtags for social text: ensure '#' prefix\nconst socialTags = rawTags\n  .split(/[\\s,]+/)\n  .map(t => t.trim())\n  .filter(Boolean)\n  .map(t => t.startsWith('#') ? t : ('#' + t))\n  .join(' ');\n\n// Check scheduling: if date provided, parse it\nlet scheduledAt = now.toISOString();\nlet isScheduled = false;\n\nconst rawDate = data['Schedule Time (Leave blank for immediate)'];\nif (rawDate && String(rawDate).trim()) {\n  const parsedDate = new Date(rawDate);\n  if (!isNaN(parsedDate.getTime()) && parsedDate.getTime() > now.getTime()) {\n    scheduledAt = parsedDate.toISOString();\n    isScheduled = true;\n  }\n}\n\nconst status = isScheduled ? 'scheduled' : 'completed';\n\n// Map binary: if Media_Attachment exists, map it to 'data' for YouTube\nconst binaryIn = $input.item.binary || {};\nconst binaryOut = {};\nif (binaryIn.Media_Attachment) {\n  binaryOut.data = binaryIn.Media_Attachment;\n}\n\nreturn {\n  json: {\n    status: status,\n    scheduled_at: scheduledAt,\n    master_text: baseText,\n    master_hashtags: ytTags,\n    media_url: '',\n    post_to_x: hasPlatform('x') || hasPlatform('twitter'),\n    post_to_linkedin: hasPlatform('linkedin'),\n    post_to_facebook: hasPlatform('facebook'),\n    post_to_instagram: hasPlatform('instagram'),\n    post_to_threads: hasPlatform('threads'),\n    post_to_youtube: postYouTube,\n    x_override: data['X (Twitter) Custom Copy (max 280 chars)'] || '',\n    linkedin_override: data['LinkedIn Custom Copy'] || '',\n    instagram_override: data['Instagram Custom Caption'] || '',\n    threads_override: data['Threads Custom Copy'] || '',\n    youtube_title: (data['YouTube Video Title'] && data['YouTube Video Title'].trim()) || baseText.slice(0, 100)\n  },\n  binary: binaryOut\n};"
      }
    },
