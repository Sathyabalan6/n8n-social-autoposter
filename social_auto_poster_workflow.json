    {
      "id": "fetch-due-posts",
      "name": "Fetch Scheduled Posts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [-208, 1120],
      "parameters": {
        "operation": "get",
        "dataTableId": { "mode": "id", "value": "04Y6TGIEdNDWPCp7" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "status", "keyValue": "scheduled" }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "filter-and-adapt-content",
      "name": "Filter Due Posts & Format Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [256, 912],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date().getTime();\nconst due = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const postTime = new Date(row.scheduled_at || 0).getTime();\n  \n  if (postTime <= now) {\n    const baseText = row.master_text || '';\n    const baseTags = row.master_hashtags ? (' ' + row.master_hashtags.trim()) : '';\n\n    const xText = ((row.x_override && row.x_override.trim()) || baseText).slice(0, 270) + baseTags;\n    const linkedinText = ((row.linkedin_override && row.linkedin_override.trim()) || baseText) + (baseTags ? ('\\n\\n' + baseTags) : '');\n    const facebookText = baseText + (baseTags ? ('\\n\\n' + baseTags) : '');\n    const igCaption = ((row.instagram_override && row.instagram_override.trim()) || baseText) + (baseTags ? ('\\n\\n' + baseTags) : '');\n    const threadsText = ((row.threads_override && row.threads_override.trim()) || baseText) + (baseTags ? ('\\n\\n' + baseTags) : '');\n    const ytTitle = ((row.youtube_title && row.youtube_title.trim()) || baseText).slice(0, 100);\n\n    due.push({\n      json: {\n        ...row,\n        x_post: xText,\n        linkedin_post: linkedinText,\n        facebook_post: facebookText,\n        instagram_caption: igCaption,\n        threads_post: threadsText,\n        youtube_title: ytTitle\n      }\n    });\n  }\n}\n\nreturn due;"
      }
    },
