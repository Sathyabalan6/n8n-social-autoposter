    {
      "id": "normalize-form-data",
      "name": "Consolidate Multi-Page Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 200],
      "parameters": {
        "jsCode": "// --- PLATFORM COMPILER & SCHEMA VALIDATION GATE ---\nconst p1 = $('Social Media Form Trigger').first().json || {};\nconst p2 = $('Step 2: Platform Customization').first().json || {};\nconst p3 = $('Step 3: Preview and Approval').first().json || {};\n\nconst now = new Date();\n\nconst selected = Array.isArray(p1['Select Platforms to Publish'])\n  ? p1['Select Platforms to Publish']\n  : (p1['Select Platforms to Publish'] ? [p1['Select Platforms to Publish']] : []);\n\nconst hasPlatform = (name) => selected.some(p => String(p).toLowerCase().includes(name.toLowerCase()));\nconst postYouTube = hasPlatform('youtube') || Boolean(p2['YouTube Video Title'] && p2['YouTube Video Title'].trim());\n\nconst baseText = p1['Master Description / Content'] || '';\nconst rawTags = p1['Master Hashtags'] || '';\n\n// 1. YouTube Validation & Compilation\n// Title: max 100 chars (optimal 50-70). Strip illegal characters (< and >).\nlet ytTitle = (p2['YouTube Video Title'] || baseText.slice(0, 70)).replace(/[<>]/g, '').trim().slice(0, 100);\n// Tags: comma-separated without '#', max 8 tags, max 500 chars total length\nconst ytTagArray = rawTags.split(/[\\s,]+/).map(t => t.replace(/^#/, '').trim()).filter(Boolean).slice(0, 8);\nlet ytTags = ytTagArray.join(', ').slice(0, 500);\n\n// 2. X (Twitter) Validation & Compilation\n// Hard limit: 280 characters. Max 2 hashtags to avoid spam throttle.\nconst xRawTags = rawTags.split(/[\\s,]+/).map(t => t.trim()).filter(Boolean).map(t => t.startsWith('#') ? t : ('#' + t)).slice(0, 2).join(' ');\nconst xOverride = p2['X (Twitter) Custom Copy (max 280 chars)'] && p2['X (Twitter) Custom Copy (max 280 chars)'].trim();\nlet xBody = xOverride || baseText;\nconst xAvailable = 280 - (xRawTags ? (xRawTags.length + 1) : 0);\nif (xBody.length > xAvailable) {\n  xBody = xBody.slice(0, xAvailable - 3);\n  const sp = xBody.lastIndexOf(' ');\n  if (sp > 0) xBody = xBody.slice(0, sp);\n  xBody += '...';\n}\nconst xPost = (xBody + (xRawTags ? (' ' + xRawTags) : '')).trim();\n\n// 3. LinkedIn Validation & Compilation\n// Hard limit: 3,000 characters. 3-5 camelCase alphanumeric hashtags.\nconst liRawTags = rawTags.split(/[\\s,]+/).map(t => t.trim().replace(/^#/, '')).filter(t => /^[a-zA-Z0-9]+$/.test(t)).slice(0, 5).map(t => '#' + t.charAt(0).toUpperCase() + t.slice(1)).join(' ');\nconst liBody = (p2['LinkedIn Custom Story'] && p2['LinkedIn Custom Story'].trim()) || baseText;\nconst liPost = (liBody.slice(0, 2800) + (liRawTags ? ('\\n\\n' + liRawTags) : '')).trim().slice(0, 3000);\n\n// 4. Threads Validation & Compilation\n// Hard limit: 500 characters. Exactly 1 Topic Tag without '#' symbol (max 50 chars).\nconst threadsTag = rawTags.split(/[\\s,]+/).map(t => t.replace(/^#/, '').trim()).filter(Boolean)[0] || '';\nconst cleanTopicTag = threadsTag.slice(0, 50);\nlet threadsBody = (p2['Threads Custom Copy'] && p2['Threads Custom Copy'].trim()) || baseText;\nconst threadsAvail = 500 - (cleanTopicTag ? (cleanTopicTag.length + 2) : 0);\nif (threadsBody.length > threadsAvail) {\n  threadsBody = threadsBody.slice(0, threadsAvail - 3) + '...';\n}\nconst threadsPost = (threadsBody + (cleanTopicTag ? ('\\n\\n' + cleanTopicTag) : '')).trim().slice(0, 500);\n\n// 5. Instagram Validation & Compilation\n// Hard limit: 2,200 characters. 3-5 targeted hashtags.\nconst igTags = rawTags.split(/[\\s,]+/).map(t => t.trim()).filter(Boolean).map(t => t.startsWith('#') ? t : ('#' + t)).slice(0, 5).join(' ');\nconst igBody = (p2['Instagram Custom Caption'] && p2['Instagram Custom Caption'].trim()) || baseText;\nconst igCaption = (igBody.slice(0, 2000) + (igTags ? ('\\n\\n' + igTags) : '')).trim().slice(0, 2200);\n\n// 6. Facebook Validation & Compilation\n// Hard limit: 63,206 characters. 0-1 hashtag.\nconst fbTag = rawTags.split(/[\\s,]+/).map(t => t.trim()).filter(Boolean).map(t => t.startsWith('#') ? t : ('#' + t)).slice(0, 1).join(' ');\nconst fbPost = (baseText + (fbTag ? ('\\n\\n' + fbTag) : '')).trim().slice(0, 60000);\n\n// Schedule Handling\nlet scheduledAt = now.toISOString();\nlet isScheduled = false;\n\nconst rawDate = p1['Schedule Date (Leave empty for immediate)'];\nconst rawTime = p1['Schedule Time (HH:MM in 24hr format, e.g. 14:30)'];\n\nif (rawDate && String(rawDate).trim()) {\n  let combinedStr = String(rawDate).trim();\n  if (rawTime && /^\\d{1,2}:\\d{2}$/.test(rawTime.trim())) {\n    combinedStr += 'T' + rawTime.trim() + ':00+05:30';\n  }\n  const parsedDate = new Date(combinedStr);\n  if (!isNaN(parsedDate.getTime()) && parsedDate.getTime() > now.getTime()) {\n    scheduledAt = parsedDate.toISOString();\n    isScheduled = true;\n  }\n}\n\nconst status = isScheduled ? 'scheduled' : 'completed';\n\n// Media Selection: Custom YouTube video from Step 2 takes priority; otherwise Master Media from Step 1\nconst p1Binary = $('Social Media Form Trigger').first().binary || {};\nconst p2Binary = $('Step 2: Platform Customization').first().binary || {};\n\nconst binaryOut = {};\nif (p2Binary.Custom_YouTube_Video) {\n  binaryOut.data = p2Binary.Custom_YouTube_Video;\n} else if (p1Binary.Master_Media_Attachment) {\n  binaryOut.data = p1Binary.Master_Media_Attachment;\n}\n\nreturn {\n  json: {\n    status: status,\n    scheduled_at: scheduledAt,\n    master_text: baseText,\n    master_hashtags: ytTags,\n    media_url: '',\n    post_to_x: hasPlatform('x') || hasPlatform('twitter'),\n    post_to_linkedin: hasPlatform('linkedin'),\n    post_to_facebook: hasPlatform('facebook'),\n    post_to_instagram: hasPlatform('instagram'),\n    post_to_threads: hasPlatform('threads'),\n    post_to_youtube: postYouTube,\n    x_override: xPost,\n    linkedin_override: liPost,\n    instagram_override: igCaption,\n    threads_override: threadsPost,\n    youtube_title: ytTitle\n  },\n  binary: binaryOut\n};"
      }
    },
