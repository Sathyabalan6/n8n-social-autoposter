    {
      "id": "filter-and-adapt-content",
      "name": "Filter Due Posts & Format Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, 680],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date().getTime();\nconst due = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const postTime = new Date(row.scheduled_at || 0).getTime();\n  \n  if (postTime <= now) {\n    due.push(item);\n  }\n}\n\nreturn due;"
      }
    },
