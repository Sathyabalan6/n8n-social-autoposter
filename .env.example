# Server Configuration
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Enterprise Security & Authentication (Must be >= 32 characters in production)
ENCRYPTION_SECRET=your_super_secret_vault_encryption_key_here_min_32_chars
ENCRYPTION_SALT=optional_custom_salt_for_vault_derivation
API_KEY=your_optional_admin_api_key_for_production_protection
JWT_SECRET=your_jwt_signing_secret_here_min_32_chars
ADMIN_EMAIL=admin@socialpulse.local
ADMIN_PASSWORD=ChangeMeOnFirstBoot2026!

# Database Configuration (High-performance embedded SQLite WAL engine)
SQLITE_PATH=./posts.sqlite

# Enterprise PostgreSQL Schema Migrations (Optional)
# DATABASE_URL=postgresql://socialpulse:pulse_secret_pass@localhost:5432/socialpulse_db
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=socialpulse_db
# PGUSER=socialpulse
# PGPASSWORD=pulse_secret_pass
# PGSSLMODE=disable

# Google / YouTube Data API v3 OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
YOUTUBE_DEFAULT_PRIVACY=unlisted

# Meta API Configuration (Facebook, Instagram, Threads)
META_GRAPH_VERSION=v20.0
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
THREADS_ACCESS_TOKEN=

# X (Twitter) API v2 Credentials
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn API Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Cloudflare R2 / AWS S3 Cloud Storage (Enables Live Meta Instagram & Facebook Media Ingestion)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
